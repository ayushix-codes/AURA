{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with AURA points, preferences, and authentication metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the client" },
        "email": { "type": "string", "description": "Email address" },
        "profilePhoto": { "type": "string", "description": "Profile picture URL" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "preferences": { "type": "object", "description": "AURA memory style and aesthetic preferences" },
        "auraPoints": { "type": "number", "description": "Current AURA loyalty points balance" }
      },
      "required": ["name", "email", "createdAt", "auraPoints"]
    },
    "SavedLook": {
      "title": "SavedLook",
      "description": "Personalized beauty and style look generated by AURA AI",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title or name of the look" },
        "generatedLook": { "type": "object", "description": "Structured JSON look specifications" },
        "referenceImages": { "type": "array", "description": "Uploaded inspiration and reference photos" },
        "outfit": { "type": "string", "description": "Outfit pairing context" },
        "occasion": { "type": "string", "description": "Occasion context e.g. Sangeet, Wedding" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["title", "generatedLook", "createdAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User's saved artisan/professional",
      "type": "object",
      "properties": {
        "professionalId": { "type": "string", "description": "Identifier of the saved professional" },
        "addedAt": { "type": "string", "description": "Timestamp when added to favorites" }
      },
      "required": ["professionalId", "addedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Appointment reservation with an artisan or multi-professional plan",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Client user ID" },
        "professionalId": { "type": "string", "description": "Booked professional ID" },
        "services": { "type": "array", "description": "List of selected services" },
        "date": { "type": "string", "description": "Booking date YYYY-MM-DD" },
        "time": { "type": "string", "description": "Time slot e.g. 14:00" },
        "status": { "type": "string", "enum": ["confirmed", "completed", "cancelled"] },
        "totalPrice": { "type": "number", "description": "Total price in INR" },
        "lookId": { "type": "string", "description": "Associated saved look ID" },
        "visualBriefId": { "type": "string", "description": "Associated visual brief ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["userId", "professionalId", "services", "date", "time", "status", "totalPrice"]
    },
    "Professional": {
      "title": "Professional",
      "description": "Verified beauty and styling artisan profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Artisan name" },
        "profilePhoto": { "type": "string", "description": "Profile picture URL" },
        "location": { "type": "string", "description": "City and service territory" },
        "specialization": { "type": "string", "description": "Primary domain of mastery" },
        "services": { "type": "array", "description": "Services offered with pricing" },
        "pricing": { "type": "string", "description": "General price tier" },
        "portfolioImages": { "type": "array", "description": "Showcase portfolio photographs" },
        "availability": { "type": "array", "description": "Available booking slots" },
        "ratings": { "type": "number", "description": "Star rating average" },
        "reviewsCount": { "type": "number", "description": "Total verified reviews" },
        "auraPointsReward": { "type": "number", "description": "AURA Points awarded on booking" },
        "homeService": { "type": "boolean", "description": "Whether at-home signature coverage is available" },
        "description": { "type": "string", "description": "Biography and artisan statement" }
      },
      "required": ["name", "location", "specialization", "services", "ratings"]
    },
    "VisualBrief": {
      "title": "VisualBrief",
      "description": "Consultation dossier between client and professional",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Client user ID" },
        "customerRequest": { "type": "string", "description": "Original natural language request" },
        "personalizedLook": { "type": "object", "description": "Structured look specifications" },
        "referenceImage": { "type": "string", "description": "Primary reference image URL" },
        "outfit": { "type": "string", "description": "Outfit and color scheme" },
        "occasion": { "type": "string", "description": "Occasion context" },
        "requestedServices": { "type": "array", "description": "Target services" },
        "makeupPreferences": { "type": "string", "description": "Specific makeup directives" },
        "hairPreferences": { "type": "string", "description": "Specific hair directives" },
        "nailPreferences": { "type": "string", "description": "Specific nail directives" },
        "jewelry": { "type": "string", "description": "Jewelry pairing" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["userId", "customerRequest", "personalizedLook", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified client review for a completed booking",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "professionalId": { "type": "string", "description": "Reviewed professional ID" },
        "bookingId": { "type": "string", "description": "Completed booking verification ID" },
        "rating": { "type": "number", "description": "1-5 rating" },
        "reviewText": { "type": "string", "description": "Review commentary" },
        "service": { "type": "string", "description": "Specific service reviewed" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["userId", "professionalId", "bookingId", "rating", "reviewText"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root user account documents"
    },
    "/users/{userId}/savedLooks/{lookId}": {
      "schema": "SavedLook",
      "description": "Saved personalized AI looks per user"
    },
    "/users/{userId}/favorites/{professionalId}": {
      "schema": "Favorite",
      "description": "Artisans bookmarked by user"
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "User appointments and service records"
    },
    "/professionals/{professionalId}": {
      "schema": "Professional",
      "description": "Artisan directory profiles"
    },
    "/visualBriefs/{briefId}": {
      "schema": "VisualBrief",
      "description": "Shareable consultation visual briefs"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Verified reviews for professionals"
    }
  }
}
